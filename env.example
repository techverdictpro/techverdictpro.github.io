# TechWise Pro - Environment Configuration Template
# Copy this file to .env and fill in your actual values

# ============================================
# CLAUDE API (REQUIRED)
# ============================================
# Get your API key from: https://console.anthropic.com
# IMPORTANT: This is REQUIRED for the system to work
ANTHROPIC_API_KEY=sk-ant-your-actual-api-key-here

# ============================================
# AFFILIATE PROGRAMS
# ============================================

# Amazon Associates
# Register at: https://affiliate-program.amazon.com
# Format: yoursite-20 (replace 'yoursite' with your site name)
AMAZON_TAG=yoursite-20

# eBay Partner Network
# Register at: https://partnernetwork.ebay.com
# Campaign ID from your eBay Partner dashboard
EBAY_CAMPAIGN_ID=your-ebay-campaign-id

# AliExpress Affiliate (via Admitad)
# Register at: https://www.admitad.com
# Your affiliate tracking ID
ALIEXPRESS_AFFILIATE_ID=your-aliexpress-aff-id

# ============================================
# SITE CONFIGURATION
# ============================================

# Your site URL (without trailing slash)
SITE_URL=https://yoursite.com

# Your site name
SITE_NAME=TechWise Pro

# Contact email (for site footer, etc.)
SITE_EMAIL=contact@yoursite.com

# ============================================
# GOOGLE SERVICES (OPTIONAL)
# ============================================

# Google AdSense Publisher ID
# Get from: https://www.google.com/adsense
# Format: ca-pub-1234567890123456
ADSENSE_ID=ca-pub-your-publisher-id-here

# Google Analytics Tracking ID
# Get from: https://analytics.google.com
# Format: G-XXXXXXXXXX or UA-XXXXXXXXX-X
GA_TRACKING_ID=G-your-tracking-id

# Google Search Console verification code (optional)
GSC_VERIFICATION_CODE=your-verification-code

# ============================================
# WORDPRESS (OPTIONAL)
# ============================================
# Only if you're using WordPress auto-publish

# WordPress Site URL
WP_SITE_URL=https://yourwordpresssite.com

# WordPress Application Password
# Create at: WP Admin → Users → Profile → Application Passwords
WP_USERNAME=your-wp-username
WP_APP_PASSWORD=your-app-password-here

# Default WordPress Category ID for auto-published articles
WP_DEFAULT_CATEGORY=1

# ============================================
# EMAIL MARKETING (OPTIONAL)
# ============================================

# Mailchimp API Key
# Get from: https://mailchimp.com/help/about-api-keys/
MAILCHIMP_API_KEY=your-mailchimp-key

# Mailchimp List ID
MAILCHIMP_LIST_ID=your-list-id

# ============================================
# ADVANCED SETTINGS
# ============================================

# Content Generation Settings
ARTICLES_PER_DAY=4
MIN_WORD_COUNT=1500
MAX_WORD_COUNT=2500

# Auto-publish to WordPress (true/false)
AUTO_PUBLISH_WP=false

# Enable email notifications on errors (true/false)
EMAIL_NOTIFICATIONS=false
NOTIFICATION_EMAIL=admin@yoursite.com

# Debug mode (true/false) - shows detailed logs
DEBUG_MODE=false

# ============================================
# NOTES
# ============================================
# 
# REQUIRED to start:
# - ANTHROPIC_API_KEY
#
# RECOMMENDED for monetization:
# - AMAZON_TAG
# - EBAY_CAMPAIGN_ID (or ALIEXPRESS_AFFILIATE_ID)
# - ADSENSE_ID (after site has traffic)
#
# OPTIONAL:
# - WordPress settings (if using WP)
# - Email marketing (for extra revenue)
# - Analytics (for tracking)
#
# After filling out, rename this file from .env.example to .env
#
# SECURITY WARNING:
# NEVER commit .env file to Git or share publicly!
# Add .env to your .gitignore file
#
